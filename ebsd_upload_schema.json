{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EBSD Upload",
  "description": "Schema for uploading EBSD files and assigning metadata based on the selected IGSNs.",
  "type": "object",
  "required": [
    "lookup",
    "ebsd_id",
    "files"
  ],
  "definitions": {
    "files": {
      "$id": "files",
      "type": "object",
      "format": "grid",
      "properties": {
        "targetPath": {
          "type": "string",
          "title": "Target Path",
          "watch": {
            "hid": "root.ebsd_id"
          },
          "options": {
            "hidden": true
          },
          "template": "{{hid}}"
        },
        "file": {
          "type": "array",
          "propertyOrder": 1,
          "title": "Upload files",
          "description": "Stores uploaded file IDs from one or more selected folders as a flattened file list.",
          "items": {
            "type": "string",
            "links": [
              {
                "rel": "View",
                "title": "View",
                "href": "/api/v1/file/{{self}}/download?contentDisposition=inline",
                "class": "girder-file-link"
              },
              {
                "rel": "Download",
                "title": "Download",
                "href": "/api/v1/file/{{self}}/download",
                "download": true,
                "class": "girder-file-link"
              }
            ]
          },
          "default": []
        },
        "button": {
          "title": "Browse or Drop Folders",
          "format": "button",
          "propertyOrder": 2,
          "options": {
            "button": {
              "action": "ebsdFolderUploadCB",
              "uploadFor": "file",
              "multiple": true,
              "allowDirectories": true,
              "flattenDirectoryStructure": true,
              "inputAttributes": {
                "multiple": true,
                "webkitdirectory": true,
                "directory": true
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "ebsd_id": {
      "title": "EBSD ID",
      "description": "Auto-generated unique identifier for the EBSD upload.",
      "type": "string",
      "template": "{{formatEbsdParamsShort lookup}}",
      "readOnly": true,
      "propertyOrder": 0,
      "watch": {
        "lookup": "root.lookup"
      },
      "options": {
        "grid_columns": 12
      }
    },
    "lookup": {
      "type": "array",
      "title": "IGSNs",
      "description": "Select one or more IGSNs",
      "notes": "Search and select one or more IGSN identifiers associated with this upload.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "autocomplete",
        "options": {
          "autocomplete": {
            "search": "search_deposition",
            "renderResult": "render_deposition",
            "getResultValue": "get_deposition_value",
            "autoSelect": true,
            "debounceTime": 500
          }
        }
      },
      "propertyOrder": 1
    },
    "files": {
      "title": "Related files",
      "description": "Upload EBSD files for this upload. Make sure they have unique names.",
      "$ref": "#/definitions/files",
      "propertyOrder": 2
    }
  }
}
